# Copy this file to ".env" and fill in your values. Do NOT commit .env.
# Used by tools/fetch_kbars.py (and live runs).

BROKER_ID=your_id_number
BROKER_PWD=your_login_password
FUT_ACCOUNT=F020000-1234567        # broker_code-account
CERT_ID=                           # optional; defaults to BROKER_ID
SKCOM_DLL=D:\CapitalAPI_2.13.58_PythonExample\CapitalAPI_2.13.58_PythonExample\元件\x64\SKCOM.dll
SKCOM_TEST_ENV=0                   # 0 = 正式環境 (use for history), 1 = 測試環境

# Telegram entry/exit notifications (optional; both blank = off).
FUT_DAYTRADE_TG_BOT_TOKEN=          # from @BotFather /newbot
FUT_DAYTRADE_TG_CHAT_ID=            # your chat/group id (see @userinfobot or getUpdates)
